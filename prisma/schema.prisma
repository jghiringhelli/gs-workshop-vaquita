generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TandaStatus {
  forming
  active
  completed
  cancelled
}

enum ParticipantRole {
  organizer
  member
}

enum ContributionStatus {
  pending
  paid
  late
  missed
}

model User {
  id              Int           @id @default(autoincrement())
  email           String        @unique
  name            String
  passwordHash    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizedTandas Tanda[]       @relation("TandaOrganizer")
  participations  Participant[]
  organizedPools  Pool[]        @relation("PoolOrganizer")
  poolMemberships PoolMember[]  @relation("PoolMemberships")
}

model Tanda {
  id                    Int            @id @default(autoincrement())
  name                  String
  organizerId           Int
  organizer             User           @relation("TandaOrganizer", fields: [organizerId], references: [id])
  contributionAmount    Float
  status                TandaStatus    @default(forming)
  /// 0 while forming; increments to 1 on start, then on each advance
  currentRound          Int            @default(0)
  /// Set to participant count atomically during FORMING→ACTIVE; 0 while forming
  totalRounds           Int            @default(0)
  /// Set to now() on start and on each advance; null while forming
  currentRoundStartedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  participants          Participant[]
  contributions         Contribution[]
}

model Participant {
  id               Int                @id @default(autoincrement())
  userId           Int
  tandaId          Int
  user             User               @relation(fields: [userId], references: [id])
  tanda            Tanda              @relation(fields: [tandaId], references: [id])
  role             ParticipantRole    @default(member)
  /// null while tanda is forming; assigned atomically during FORMING→ACTIVE
  rotationPosition Int?
  /// true when participant has missed 2 consecutive contributions
  isDefaulter      Boolean            @default(false)
  createdAt        DateTime           @default(now())
  contributions    Contribution[]

  @@unique([userId, tandaId])
}

model Contribution {
  id            Int                @id @default(autoincrement())
  tandaId       Int
  participantId Int
  round         Int
  /// Actual amount paid: contributionAmount for on-time, contributionAmount*(1+penaltyRate) for late
  amount        Float
  status        ContributionStatus @default(pending)
  paidAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tanda         Tanda              @relation(fields: [tandaId], references: [id])
  participant   Participant        @relation(fields: [participantId], references: [id])

  /// One contribution slot per participant per round
  @@unique([participantId, round])
}

// ─── Pool (group savings jar) ─────────────────────────────────────────────────

enum PoolStatus {
  open
  funded
  closed
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

model Pool {
  id            Int                @id @default(autoincrement())
  name          String
  purpose       String?
  /// In the pool's currency unit (e.g. 1000 for 1000 MXN)
  targetAmount  Float
  currency      String             @default("MXN")
  status        PoolStatus         @default(open)
  organizerId   Int
  organizer     User               @relation("PoolOrganizer", fields: [organizerId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  members       PoolMember[]
  contributions PoolContribution[]
  withdrawals   Withdrawal[]
}

model PoolMember {
  id            Int                @id @default(autoincrement())
  poolId        Int
  userId        Int
  pool          Pool               @relation(fields: [poolId], references: [id])
  user          User               @relation("PoolMemberships", fields: [userId], references: [id])
  joinedAt      DateTime           @default(now())
  contributions PoolContribution[]
  withdrawals   Withdrawal[]

  @@unique([poolId, userId])
}

model PoolContribution {
  id          Int        @id @default(autoincrement())
  poolId      Int
  memberId    Int
  /// Amount in smallest currency unit (cents / centavos)
  amountCents Int
  note        String?
  createdAt   DateTime   @default(now())
  pool        Pool       @relation(fields: [poolId], references: [id])
  member      PoolMember @relation(fields: [memberId], references: [id])
}

model Withdrawal {
  id          Int              @id @default(autoincrement())
  poolId      Int
  requestedBy Int
  amountCents Int
  note        String?
  status      WithdrawalStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  pool        Pool             @relation(fields: [poolId], references: [id])
  requester   PoolMember       @relation(fields: [requestedBy], references: [id])
}
