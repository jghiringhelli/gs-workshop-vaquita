// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ──────────────────────────────────────────────
// Enums (stored as TEXT in SQLite)
// ──────────────────────────────────────────────

enum TandaStatus {
  FORMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ParticipantRole {
  ORGANIZER
  MEMBER
}

enum ContributionStatus {
  PENDING
  PAID
  LATE
  MISSED
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  username             String           @unique
  name                 String?
  passwordHash         String
  participants         Participant[]
  organizedPools       Pool[]           @relation("PoolOrganizer")
  poolMemberships      PoolMember[]
  withdrawalsRequested PoolWithdrawal[]
  createdAt            DateTime         @default(now())
}

/// A rotating savings group (tanda / vaquita).
/// totalRounds is set to the participant count when the tanda starts.
model Tanda {
  id                 String         @id @default(cuid())
  name               String
  organizerId        String
  contributionAmount Float
  status             TandaStatus    @default(FORMING)
  currentRound       Int            @default(0)
  totalRounds        Int            @default(0)
  participants       Participant[]
  contributions      Contribution[]
  createdAt          DateTime       @default(now())
}

/// Join table between User and Tanda.
/// rotationPosition is null until the tanda starts (randomised at FORMING → ACTIVE).
model Participant {
  id               String             @id @default(cuid())
  userId           String
  tandaId          String
  role             ParticipantRole    @default(MEMBER)
  rotationPosition Int?
  user             User               @relation(fields: [userId], references: [id])
  tanda            Tanda              @relation(fields: [tandaId], references: [id])
  contributions    Contribution[]
  createdAt        DateTime           @default(now())

  @@unique([userId, tandaId])
}

/// A collective savings pool with a target amount.
/// Status moves OPEN → FUNDED automatically once contributions reach targetAmount.
/// Organiser can dissolve (→ CLOSED) at any time.
model Pool {
  id            String             @id @default(cuid())
  name          String
  purpose       String?
  targetAmount  Int                // stored in cents
  currency      String             @default("MXN")
  status        PoolStatus         @default(OPEN)
  organizerId   String
  organizer     User               @relation("PoolOrganizer", fields: [organizerId], references: [id])
  members       PoolMember[]
  contributions PoolContribution[]
  withdrawals   PoolWithdrawal[]
  createdAt     DateTime           @default(now())
}

model PoolMember {
  id            String             @id @default(cuid())
  poolId        String
  userId        String
  pool          Pool               @relation(fields: [poolId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  contributions PoolContribution[]
  votes         WithdrawalVote[]
  createdAt     DateTime           @default(now())

  @@unique([poolId, userId])
}

/// A single payment into a pool by a member.
model PoolContribution {
  id          String     @id @default(cuid())
  poolId      String
  memberId    String
  amountCents Int
  note        String?
  pool        Pool       @relation(fields: [poolId], references: [id])
  member      PoolMember @relation(fields: [memberId], references: [id])
  createdAt   DateTime   @default(now())
}

enum PoolStatus {
  OPEN
  FUNDED
  CLOSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoteValue {
  APPROVE
  REJECT
}

/// A withdrawal request raised by the organiser.
/// receiptUrl must be set before any votes can be cast.
/// Auto-resolves when approve/reject vote thresholds are reached (single transaction).
model PoolWithdrawal {
  id                String           @id @default(cuid())
  poolId            String
  requestedByUserId String
  amountCents       Int
  reason            String
  receiptUrl        String?
  status            WithdrawalStatus @default(PENDING)
  resolvedAt        DateTime?
  pool              Pool             @relation(fields: [poolId], references: [id])
  requestedBy       User             @relation(fields: [requestedByUserId], references: [id])
  votes             WithdrawalVote[]
  createdAt         DateTime         @default(now())
}

/// One member's vote on a withdrawal.
/// A member cannot vote twice on the same withdrawal (unique constraint).
model WithdrawalVote {
  id           String         @id @default(cuid())
  withdrawalId String
  voterId      String         // PoolMember.id
  vote         VoteValue
  withdrawal   PoolWithdrawal @relation(fields: [withdrawalId], references: [id])
  voter        PoolMember     @relation(fields: [voterId], references: [id])
  createdAt    DateTime       @default(now())

  @@unique([withdrawalId, voterId])
}

/// A single payment by one participant for one round.
/// The unique constraint prevents duplicate contributions per participant per round.
model Contribution {
  id            String             @id @default(cuid())
  tandaId       String
  participantId String
  round         Int
  amount        Float
  status        ContributionStatus @default(PENDING)
  tanda         Tanda              @relation(fields: [tandaId], references: [id])
  participant   Participant        @relation(fields: [participantId], references: [id])
  createdAt     DateTime           @default(now())

  @@unique([participantId, round])
}
