# Environment variables for Tanda API
# Copy this file to .env and fill in the values

# JWT secret for signing tokens
JWT_SECRET=

# SQLite database URL (default for local dev)
DATABASE_URL="file:./dev.db"

# Maximum participants per tanda (default: 20)
MAX_PARTICIPANTS=20

# Penalty percent for late contributions (default: 5)
PENALTY_PERCENT=5
